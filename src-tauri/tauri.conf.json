{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "The Rest",
  "version": "0.4.2",
  "identifier": "com.insidewill.lyricvideostudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "the rest",
        "width": 1280,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Video",
    "copyright": "© insidewill · MIT License",
    "shortDescription": "Just make music. the rest handles beats, lyric videos, and everything after.",
    "longDescription": "the rest is a local-first desktop toolkit for underground artists: grab beats with auto key/BPM tagging, sync lyrics to your track, and render YouTube/Reels-ready lyric videos (GPU H.264 + bundled FFmpeg, source-quality audio) — no login, no upload, no server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/1nsidewill/the-rest/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxNUY0NzdDQTFEODBBNzkKUldSNUN0aWhmRWRmZ1lGbklrZ2hQanRVZ1pvUE5rY0k2ZG5zU01MTDFxbzJXNFZPRkJQYTk1cEYK"
    }
  }
}
